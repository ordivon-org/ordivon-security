  "acceptedClaims": [
    "projection integrity and current applicability are separate facts",
    "metadata-only source generation/envelope advance does not stale a derivation when exact dependencies are unchanged",
    "semantic history advance makes the exact retained old projection stale while preserving its integrity",
    "a newly recomputed projection bound to current dependencies is applicable",
    "unavailable current authority yields UNKNOWN rather than guessed freshness",
    "fresh Workspace/process replacement reproduces the classification with no durable freshness state",
    "no clock TTL lease Trust Reputation or generic Freshness service is forced by this consumer",
    "Runtime physical Workspace source identity is execution evidence and is not the domain applicability identity"
  ],
  "limitations": [
    "only exact enumerable history and current-sensor dependencies are tested",
    "time-decaying facts where age is itself semantic are not tested",
    "multi-authority partial orders and probabilistic evidence are not tested",
    "C1-N private witness freshness remains a separate consumer if current predicate identity cannot be independently observed",
    "source-change and derivation-publication atomicity is not tested"
  ],
  "nextPressure": "return-to-autonomous-multi-agent-communication-coordination-collusion"
