{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordivon bounded adversarial decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "rationale",
    "strategic_revision",
    "hypothesis_updates"
  ],
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string"
    },
    "strategic_revision": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "change"],
          "properties": {
            "reason": {"type": "string"},
            "change": {"type": "string"}
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "hypothesis_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "confidence"],
        "properties": {
          "subject": {"type": "string"},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
