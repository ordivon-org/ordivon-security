{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/schemas/security/campaign-manifest-v0.json",
  "title": "Ordivon Security Campaign Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "world_id",
    "authority_ref",
    "capability_envelope",
    "consequence_envelope",
    "actors",
    "objectives",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": 0},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "world_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "authority_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "capability_envelope": {"type": "object"},
    "consequence_envelope": {"type": "object"},
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor_id", "role"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["red", "blue", "neutral", "user", "service", "observer", "judge"]}
        }
      }
    },
    "objectives": {"type": "array", "minItems": 1},
    "stop_conditions": {"type": "array", "minItems": 1}
  }
}
