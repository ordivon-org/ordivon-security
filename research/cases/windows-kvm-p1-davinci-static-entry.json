  "components": [
    {
      "role": "distribution-wrapper",
      "logicalPath": "DaVinci Resolve Studio.exe",
      "byteLength": 4585876,
      "publisherClaim": "GetintoWAY",
      "signatureStatus": "unsigned",
      "facts": [
        "Advanced Installer wrapper",
        "SetupFile is DaVinci Resolve\\DaVinci.msi",
        "command line is /qr",
        "distribution includes DaVinci Resolve\\DaVinci Resolve.7z"
      ]
    },
    {
