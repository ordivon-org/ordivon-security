        "ProductVersion 21.0.30007",
        "WiX metadata",
        "references ResExt01.cab through ResExt17.cab",
        "contains both the original 20848-byte intl.dll entry and added replacement intl.dll plus Patches.txt entries"
      ]
    },
    {
      "role": "nested-msi-container",
      "logicalPath": "DaVinci Resolve/DaVinci Resolve.7z",
      "byteLength": 1164591,
      "sha256": "sha256:3542239301dddc1ce5dbc951e799c5700956be2d29398f697e65c23eb0344647",
      "facts": [
        "contains exactly DaVinci Resolve.msi",
        "embedded MSI expands to 4998144 bytes"
      ]
    },
    {
      "role": "malicious-nested-msi",
      "logicalPath": "DaVinci Resolve/nested/DaVinci Resolve.msi",
      "byteLength": 4998144,
      "publisherClaim": "GetintoWAY",
      "signatureStatus": "unsigned",
      "facts": [
        "Advanced Installer 23.8",
        "AI_DATA_SETTER is sequenced at 6401",
        "PowerShellScriptInline is sequenced at 6402",
        "condition is NOT Installed AND NOT OLDPRODUCTS",
        "downloads an attacker-controlled ZIP",
        "registers highest-privilege OneDriveStandaloneUpdate#### scheduled tasks",
        "starts every EXE found in the downloaded ZIP"
      ]
    },
    {
      "role": "crack-dll",
      "logicalPath": "DaVinci Resolve/Blackmagic Design/DaVinci Resolve/intl.dll",
      "byteLength": 152576,
      "signatureStatus": "unsigned",
      "facts": [
        "replaces a signed 20848-byte original intl.dll",
        "local RVA memory patch engine",
        "reads Patches.txt",
        "no network capability established by prior static analysis"
      ]
    }
  ],
  "maliciousBehavior": {
    "trigger": "first install",
    "downloadUrl": "https://corehubpro.com/d/windows",
    "transports": ["bitsadmin", "System.Net.WebClient"],
    "stagingPath": "%TEMP%\\DaVinci Resolve\\packagecache_x64_data.zip",
    "persistence": "OneDriveStandaloneUpdate#### scheduled task as BUILTIN Administrators with highest run level",
    "payloadExecution": "all EXE files recursively found in the downloaded archive"
  },
  "reasons": [
    "the archive contains an unsigned GetintoWAY MSI with a first-install PowerShell downloader CustomAction",
    "the downloader creates privileged scheduled-task persistence and executes attacker-controlled secondary binaries",
    "the package replaces a signed Blackmagic intl.dll with an unsigned crack and memory-patching engine",
    "static evidence is sufficient to reject generating an executable installer profile"
  ],
  "unresolvedQuestions": [
    "the exact runtime invocation edge from the wrapper or outer MSI to the nested malicious MSI has not been fully traced",
    "no Guest execution is needed to decide that the current package must not be admitted for installation"
  ],
